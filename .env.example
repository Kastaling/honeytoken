# Copy to .env and set your values:
#   cp .env.example .env

ADMIN_USER=admin
# Must be a strong, non-default password (empty and "changeme" are rejected at startup)
ADMIN_PASS=your-strong-password-here
# Random secret for admin CSRF tokens (generate with: python -c "import secrets; print(secrets.token_hex(32))")
ADMIN_SECRET_KEY=your-random-secret-here

# Primary domain shown in the admin UI and used for tracked-link previews
ROOT_DOMAIN=example.com

# Optional: extra comma-separated proxy CIDRs (added to built-in loopback + RFC1918 defaults).
# TRUSTED_PROXY_CIDRS=173.245.48.0/20,2400:cb00::/32

# Optional: path to Cloudflare IP ranges JSON (https://api.cloudflare.com/client/v4/ips)
# CLOUDFLARE_IPS_FILE=/data/cloudflare-ips.json

# Legacy env alerts (optional; prefer Discord rules in Admin → Settings)
DISCORD_WEBHOOK_URL=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
