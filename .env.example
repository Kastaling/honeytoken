# Copy to .env and set your values:
#   cp .env.example .env

ADMIN_USER=admin
# Must be a strong, non-default password (empty and "changeme" are rejected at startup)
ADMIN_PASS=your-strong-password-here

# Primary domain shown in the admin UI and used for tracked-link previews
ROOT_DOMAIN=example.com

# Legacy env alerts (optional; prefer Discord rules in Admin → Settings)
DISCORD_WEBHOOK_URL=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
